# Copy this file to .streamlit/secrets.toml (git-ignored) and fill in
# your own value. Never commit the real secrets.toml.
#
# How to get SCREENER_SESSION_ID: log into screener.in in your browser,
# open DevTools -> Application (Chrome) / Storage (Firefox) -> Cookies
# -> https://www.screener.in -> copy the `sessionid` cookie's value.
#
# Deployed on Streamlit Community Cloud? Don't upload this file at all —
# set the same key under your app's Settings -> Secrets in the Cloud
# dashboard instead, same TOML format.

SCREENER_SESSION_ID = "paste-your-screener-sessionid-cookie-here"
