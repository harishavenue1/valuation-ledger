# Copy this file to .streamlit/secrets.toml (git-ignored) and fill in
# your own value. Never commit the real secrets.toml.
#
# Deployed on Streamlit Community Cloud? Don't upload this file at all —
# set the same keys under your app's Settings -> Secrets in the Cloud
# dashboard instead, same TOML format.

# NOT required (verified 2026-08-15) — Screener's search API, top-ratios,
# and full P&L table all return complete data to a fully anonymous
# request, no login needed for anything this app fetches. Leave this
# unset/commented unless a future Screener change ends up requiring it.
# How to get one if you ever do need it: log into screener.in in your
# browser, DevTools -> Application (Chrome) / Storage (Firefox) ->
# Cookies -> https://www.screener.in -> copy the `sessionid` value.
# SCREENER_SESSION_ID = "paste-your-screener-sessionid-cookie-here"

# Optional but recommended once you deploy this to Streamlit Community
# Cloud: without it, your Base/Bull/Bear/Mgmt scenario edits only live
# in cache/scenarios.json on whichever machine's disk is running the
# app, which does NOT survive a cloud redeploy and isn't shared across
# devices. With it, scenario edits are also synced to a real tracked
# file (data/scenarios.json) in this GitHub repo via the GitHub API, so
# they persist across redeploys and are the same from any computer.
#
# How to get a token: github.com -> Settings -> Developer settings ->
# Personal access tokens -> Fine-grained tokens -> Generate new token.
# Repository access: only this repo. Permissions: Contents -> Read and
# write. Copy the token (starts with github_pat_...) here.
GITHUB_TOKEN = "paste-your-fine-grained-github-pat-here"

# Only needed if this file lives in a different repo/path than the
# defaults below. Company/price data (data/all_stocks.json) and the
# Management Guidance Tracker (data/guidance_tracker.json) are synced
# the same way, same token, same repo.
# GITHUB_REPO = "harishavenue1/valuation-ledger"
# GITHUB_DATA_PATH = "data/scenarios.json"
# GITHUB_STOCKS_PATH = "data/all_stocks.json"
# GITHUB_GUIDANCE_TRACKER_PATH = "data/guidance_tracker.json"

# Strongly recommended once deployed to Streamlit Community Cloud:
# without this, EVERY write in the app (Retrieve, Refresh, editing
# scenario inputs, Remove) runs using the GITHUB_TOKEN above with zero
# check on who's driving the browser — anyone who finds the deployed
# URL can add/remove companies and overwrite your scenario data, even
# though they never touch GitHub directly (the app is a privileged
# proxy). Set this and nothing loads until the right password is
# entered. Pick your own value — this isn't a GitHub-issued token, just
# a password you make up.
# APP_PASSWORD = "pick-your-own-password-here"
